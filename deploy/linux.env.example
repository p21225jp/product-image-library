# Reference for /etc/product-image-library.env (loaded by systemd, not by Python).
# Replace the domain and paths; do not put API tokens in this file.
ASSET_DATA_DIR=/srv/product-image-library/data
ASSET_ALLOWED_HOSTS=assets.company.example
ASSET_PUBLIC_ORIGIN=https://assets.company.example
ASSET_COOKIE_SECURE=1
ASSET_TRUSTED_PROXIES=127.0.0.1
ASSET_DISABLE_SETUP=1
PYTHONUNBUFFERED=1
